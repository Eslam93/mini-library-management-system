APP_ENV=local
DATABASE_URL=postgresql+asyncpg://library:library@127.0.0.1:55432/library
LOG_LEVEL=INFO
# Days until a new loan is due, when staff do not choose a date.
LOAN_PERIOD_DAYS=14
# FRONTEND_DIST_DIR=../frontend/dist
# Required in production: at least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=

# Sign-in
# The address browsers use to reach the app. Google sends people back to
# PUBLIC_BASE_URL/api/auth/google/callback, which must be listed on the Google OAuth client.
PUBLIC_BASE_URL=http://localhost:8000
# One button per role on the sign-in page. Defaults to true, except in production.
# DEMO_LOGIN_ENABLED=true
# Google sign-in appears when both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Comma-separated. These addresses become staff the first time they sign in with Google.
# STAFF_EMAILS=librarian@example.com
# SESSION_IDLE_MINUTES=720
# SESSION_MAX_HOURS=168
# Comma-separated origins allowed to send changes. Defaults to PUBLIC_BASE_URL, plus
# http://localhost:5173 outside production.
# ALLOWED_ORIGINS=

# Copilot. Without a key the assistant shows as unavailable; everything else works.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# COPILOT_MODEL=google/gemini-3.8-flash
# COPILOT_TIMEOUT_SECONDS=45
# COPILOT_MAX_TOOL_ROUNDS=6
# COPILOT_MAX_OUTPUT_TOKENS=2000
# COPILOT_RATE_PER_MINUTE=20
# Development only: an offline stand-in answers instead of a model. Production refuses it.
# COPILOT_FAKE_MODEL=false

# The add-book form's ISBN lookup asks Open Library. Off, it answers 503 and the form is filled
# by hand.
# ISBN_LOOKUP_ENABLED=true
